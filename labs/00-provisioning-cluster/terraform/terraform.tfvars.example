aws_region   = "us-east-1"
key_name     = "vockey"
cluster_name = "k8s-formation"

# Sizing 3 x t3.large (2 vCPU, 8 Gio RAM chacun)
# Garantit le support de la pile de formation sans risque d'OOM
control_plane_instance_type = "t3.large"
worker_instance_type        = "t3.large"

control_plane_disk_size = 35
worker_disk_size        = 30
